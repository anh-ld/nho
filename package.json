{
  "name": "@anh-ld/nho",
  "version": "0.7.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "~1.4KB Web Component abstraction",
  "keywords": [
    "nho",
    "web component"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/anh-ld/nho.git"
  },
  "author": {
    "name": "Anh Le",
    "email": "ledzanh@gmail.com"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.es.js",
      "default": "./dist/index.umd.js"
    },
    "./dist/": "./dist/"
  },
  "main": "./dist/index.umd.js",
  "files": [
    "dist",
    "src",
    "*.md"
  ],
  "scripts": {
    "build": "bun run build:module && bun run build:umd && bun run size",
    "build:module": "bun build src/index.js --minify --format=esm --target=browser --outfile=dist/index.es.js",
    "build:umd": "bun build src/umd.js --minify --format=iife --target=browser --outfile=dist/index.umd.js",
    "size": "for f in dist/*.js; do echo \"$f: $(wc -c <\"$f\") raw, $(gzip -c \"$f\" | wc -c) gzip\"; done",
    "build:example": "bun build ./example/index.html --outdir=example/dist --minify",
    "coverage": "bun test --coverage",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "e2e": "bun run build && bun test ./test/e2e/smoke.e2e.js",
    "dev": "bun ./example/index.html",
    "check": "bun fmt && bun lint --fix",
    "clean": "rm -rf dist example/dist"
  },
  "devDependencies": {
    "jsdom": "22.1.0"
  }
}
